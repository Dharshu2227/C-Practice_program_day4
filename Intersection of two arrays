#include <stdio.h>
int main() {
    int n1, n2, i, j;
    int arr1[100], arr2[100];

    printf("Enter size of first array: ");
    scanf("%d", &n1);
    printf("Enter first array elements: ");
    for (i = 0; i < n1; i++) {
        scanf("%d", &arr1[i]);
    }
    printf("Enter size of second array: ");
    scanf("%d", &n2);
    printf("Enter second array elements: ");
    for (i = 0; i < n2; i++) {
        scanf("%d", &arr2[i]);
    }
    printf("Intersection of the arrays: ");
    for (i = 0; i < n1; i++) {
        for (j = 0; j < n2; j++) {
            if (arr1[i] == arr2[j]) {
                printf("%d ", arr1[i]);
                break;
            }
        }
    }
   return 0;
}

Output:
Enter size of first array: 5
Enter first array elements: 1 2 3 4 5
Enter size of second array: 5
Enter second array elements: 3 4 5 6 7
Intersection of the arrays: 3 4 5
